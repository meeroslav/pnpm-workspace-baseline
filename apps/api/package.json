{
  "name": "@org/api",
  "version": "0.0.1",
  "private": true,
  "main": "dist/main.js",
  "files": [
    "dist/**",
    "package.json"
  ],
  "scripts": {
    "build": "node ../../tools/build-api.mjs",
    "serve:dev": "node dist/main.js",
    "serve:prod": "node dist/main.js",
    "test": "jest --passWithNoTests",
    "docker:build": "pnpm run api:prune && docker build -f apps/api/Dockerfile apps/api/dist/pruned -t org-api:local",
    "api:prune": "rm -rf dist/pruned && nx build && pnpm --filter @org/api --prod deploy dist/pruned",
    "test:ci": "jest --ci --passWithNoTests"
  },
  "nx": {
    "targets": {
      "serve:dev": {
        "continuous": true,
        "dependsOn": [
          "build"
        ]
      },
      "serve:prod": {
        "continuous": true,
        "dependsOn": [
          "build:prod"
        ]
      }
    }
  },
  "dependencies": {
    "@org/api-products": "workspace:*",
    "@org/models": "workspace:*",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "jest-junit": "^16.0.0"
  }
}
