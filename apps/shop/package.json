{
  "name": "@org/shop",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nx serve",
    "serve": "concurrently -k \"nx serve:dev @org/api\" \"nx dev @org/shop\"",
    "serve:preview": "concurrently -k \"nx serve:dev @org/api\" \"nx preview @org/shop\""
  },
  "nx": {
    "tags": [
      "scope:shop"
    ],
    "targets": {
      "serve": {
        "dependsOn": [
          "@org/api:serve"
        ]
      },
      "preview": {
        "dependsOn": [
          "build",
          "@org/api:serve"
        ]
      }
    }
  },
  "devDependencies": {
    "@org/feature-manufacturer": "workspace:*",
    "@org/models": "workspace:*",
    "@org/shared-test-utils": "workspace:*",
    "@org/shop-data": "workspace:*",
    "@org/shop-feature-product-detail": "workspace:*",
    "@org/shop-feature-products": "workspace:*",
    "@org/shop-shared-ui": "workspace:*",
    "vite-tsconfig-paths": "^6.0.1"
  }
}
