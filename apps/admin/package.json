{
  "name": "@org/admin",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "vite --port 4201 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 4201 --strictPort",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile=./test-results/junit/vitest.xml",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@org/admin-shared-ui": "workspace:*",
    "@org/admin-feature-orders": "workspace:*",
    "@org/admin-feature-products": "workspace:*",
    "@org/admin-feature-analytics": "workspace:*",
    "@org/models": "workspace:*",
    "@org/shared-test-utils": "workspace:*"
  }
}
